// Serein's Slint client. All data comes from Rust (`src/view.rs`), which maps client-core's
// `State` onto these flat rows; this file owns layout, theme and input only.

import { ScrollView } from "std-widgets.slint";

import "../../../assets/fonts/Inter-Regular.ttf";
import "../../../assets/fonts/Inter-Medium.ttf";
import "../../../assets/fonts/Inter-SemiBold.ttf";

export struct GuildItem {
    id: string,
    name: string,
    initials: string,
    color: color,
    selected: bool,
    unread: bool,
}

// kind: 0 text, 1 voice, 2 category, 3 announcement, 4 forum, 5 direct message, 6 group, 7 thread
export struct ChannelItem {
    id: string,
    name: string,
    kind: int,
    selected: bool,
    unread: bool,
    collapsed: bool,
    subtitle: string,
    initials: string,
    color: color,
}

// delivery: 0 delivered, 1 sending, 2 failed, 3 unknown outcome
export struct MessageItem {
    id: string,
    author: string,
    initials: string,
    avatar-color: color,
    time: string,
    short-time: string,
    content: string,
    markdown: styled-text,
    grouped: bool,
    delivery: int,
    edited: bool,
    divider: string,
    reply: string,
    system: bool,
    mentions-me: bool,
}

export global Theme {
    in-out property <bool> dark: true;
    out property <color> rail: dark ? #1e1f22 : #e3e5e8;
    out property <color> sidebar: dark ? #2b2d31 : #f2f3f5;
    out property <color> chat: dark ? #313338 : #ffffff;
    out property <color> raised: dark ? #383a40 : #ebedef;
    out property <color> hover: dark ? #35373c : #f2f3f5;
    out property <color> selected: dark ? #404249 : #d7d9dc;
    out property <color> input: dark ? #383a40 : #ebedef;
    out property <color> border: dark ? #1f2023 : #e1e2e4;
    out property <color> text: dark ? #dbdee1 : #313338;
    out property <color> strong: dark ? #f2f3f5 : #060607;
    out property <color> muted: dark ? #949ba4 : #5c5e66;
    out property <color> faint: dark ? #6d6f78 : #80848e;
    out property <color> accent: #5865f2;
    out property <color> accent-hover: #4752c4;
    out property <color> danger: #f23f43;
    out property <color> success: #23a55a;
    out property <color> mention: dark ? #444037 : #fdf5e1;
    out property <color> mention-bar: #f0b232;
    out property <string> font: "Inter";
}

// Interface glyphs from assets/icons/atlas.png (8 columns of 64 px cells, see index.tsv).
component Icon inherits Image {
    in property <int> index;
    in property <color> tint: Theme.muted;
    source: @image-url("../../../assets/icons/atlas.png");
    source-clip-x: mod(root.index, 8) * 64;
    source-clip-y: floor(root.index / 8) * 64;
    source-clip-width: 64;
    source-clip-height: 64;
    colorize: root.tint;
    image-fit: contain;
}

component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> fill;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.fill;
    Text {
        text: root.initials;
        color: white;
        font-family: Theme.font;
        font-weight: 600;
        font-size: root.size * 0.38;
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    border-radius: 4px;
    background: !root.enabled ? Theme.raised : root.primary ? (touch.has-hover ? Theme.accent-hover : Theme.accent) : (touch.has-hover ? Theme.selected : Theme.raised);
    opacity: root.enabled ? 1 : 0.6;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            color: root.primary ? white : Theme.text;
            font-family: Theme.font;
            font-weight: 500;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component IconButton inherits Rectangle {
    in property <int> icon;
    in property <string> label;
    in property <length> glyph: 20px;
    in property <bool> active;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        index: root.icon;
        width: root.glyph;
        height: root.glyph;
        tint: root.active ? Theme.strong : touch.has-hover ? Theme.text : Theme.muted;
    }
}

// Server rail tile: a circle that morphs to a rounded square when hovered or selected,
// with Discord's left pill for the selected (tall), hovered (medium) or unread (dot) state.
component RailTile inherits Rectangle {
    in property <string> label;
    in property <string> initials;
    in property <color> fill: Theme.raised;
    in property <bool> selected;
    in property <bool> unread;
    in property <int> icon: -1;
    callback clicked();
    width: 72px;
    height: 56px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    pill := Rectangle {
        x: 0;
        width: 4px;
        height: root.selected ? 40px : touch.has-hover ? 20px : root.unread ? 8px : 0px;
        y: (parent.height - self.height) / 2;
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
        background: Theme.strong;
        animate height { duration: 150ms; easing: ease-out; }
    }
    face := Rectangle {
        x: 12px;
        y: 4px;
        width: 48px;
        height: 48px;
        border-radius: root.selected || touch.has-hover ? 16px : 24px;
        background: root.selected || touch.has-hover ? (root.icon >= 0 ? Theme.accent : root.fill) : (root.icon >= 0 ? Theme.raised : root.fill.with-alpha(0.85));
        animate border-radius, background { duration: 150ms; easing: ease-out; }
        if root.icon >= 0: Icon {
            index: root.icon;
            width: 26px;
            height: 26px;
            tint: root.selected || touch.has-hover ? white : Theme.text;
        }
        if root.icon < 0: Text {
            text: root.initials;
            color: white;
            font-family: Theme.font;
            font-weight: 600;
            font-size: 16px;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    tip := Rectangle {
        visible: touch.has-hover;
        x: 0;
        y: 0;
    }
}

component ChannelRow inherits Rectangle {
    in property <ChannelItem> item;
    callback clicked();
    callback toggled();
    height: item.kind == 2 ? 36px : (item.kind == 5 || item.kind == 6) ? 44px : 34px;
    accessible-role: list-item;
    accessible-label: item.name;
    accessible-item-selected: item.selected;
    accessible-action-default => { if (item.kind == 2) { root.toggled(); } else { root.clicked(); } }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (item.kind == 2) { root.toggled(); } else { root.clicked(); } }
    }
    if item.kind == 2: HorizontalLayout {
        padding-left: 4px;
        padding-top: 14px;
        spacing: 2px;
        Icon {
            index: item.collapsed ? 1 : 0;
            width: 12px;
            height: 12px;
            tint: touch.has-hover ? Theme.text : Theme.muted;
        }
        Text {
            text: item.name;
            color: touch.has-hover ? Theme.text : Theme.muted;
            font-family: Theme.font;
            font-weight: 600;
            font-size: 12px;
            letter-spacing: 0.3px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    if item.kind != 2: Rectangle {
        x: 8px;
        y: 1px;
        width: parent.width - 16px;
        height: parent.height - 2px;
        border-radius: 4px;
        background: item.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
        unread-pill := Rectangle {
            visible: item.unread && !item.selected;
            x: -8px;
            width: 4px;
            height: 8px;
            y: (parent.height - 8px) / 2;
            border-top-right-radius: 4px;
            border-bottom-right-radius: 4px;
            background: Theme.strong;
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            alignment: start;
            if item.kind == 5 || item.kind == 6: Avatar {
                initials: item.initials;
                fill: item.color;
                size: 32px;
                y: (parent.height - 32px) / 2;
            }
            if item.kind != 5 && item.kind != 6: Icon {
                index: item.kind == 1 ? 32 : item.kind == 3 ? 84 : item.kind == 4 ? 34 : item.kind == 7 ? 93 : 33;
                width: 20px;
                height: 20px;
                y: (parent.height - 20px) / 2;
                tint: item.selected || item.unread ? Theme.strong : Theme.faint;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: item.name;
                    color: item.selected || item.unread ? Theme.strong : touch.has-hover ? Theme.text : Theme.muted;
                    font-family: Theme.font;
                    font-weight: item.unread ? 600 : 500;
                    font-size: 15px;
                    overflow: elide;
                }
                if item.subtitle != "": Text {
                    text: item.subtitle;
                    color: Theme.muted;
                    font-family: Theme.font;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }
}

component MessageView inherits Rectangle {
    in property <MessageItem> item;
    callback open-link(string);
    background: item.mentions-me ? Theme.mention : touch.has-hover ? (Theme.dark ? #2e3035 : #f7f7f8) : transparent;
    touch := TouchArea { }
    if item.mentions-me: Rectangle {
        x: 0;
        width: 2px;
        background: Theme.mention-bar;
    }
    VerticalLayout {
        padding-top: item.grouped ? 1px : (item.divider != "" ? 0px : 14px);
        padding-bottom: 1px;
        if item.divider != "": HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 18px;
            padding-bottom: 6px;
            spacing: 8px;
            Rectangle {
                height: 1px;
                y: (parent.height - 1px) / 2;
                background: Theme.selected;
            }
            Text {
                text: item.divider;
                color: Theme.muted;
                font-family: Theme.font;
                font-weight: 600;
                font-size: 12px;
                horizontal-stretch: 0;
            }
            Rectangle {
                height: 1px;
                y: (parent.height - 1px) / 2;
                background: Theme.selected;
            }
        }
        if item.reply != "": HorizontalLayout {
            padding-left: 72px;
            padding-right: 16px;
            padding-bottom: 2px;
            Text {
                text: "↱ " + item.reply;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 13px;
                overflow: elide;
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 16px;
            Rectangle {
                width: 40px;
                min-height: item.grouped ? 22px : 40px;
                if !item.grouped: Avatar {
                    y: 2px;
                    initials: item.initials;
                    fill: item.avatar-color;
                }
                if item.grouped && touch.has-hover: Text {
                    y: 3px;
                    width: 40px;
                    horizontal-alignment: right;
                    text: item.short-time;
                    color: Theme.faint;
                    font-family: Theme.font;
                    font-size: 11px;
                }
            }
            VerticalLayout {
                spacing: 2px;
                if !item.grouped: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: item.author;
                        color: item.system ? Theme.muted : Theme.strong;
                        font-family: Theme.font;
                        font-weight: 600;
                        font-size: 15px;
                        overflow: elide;
                    }
                    Text {
                        text: item.time;
                        color: Theme.faint;
                        font-family: Theme.font;
                        font-size: 12px;
                        vertical-alignment: bottom;
                    }
                }
                StyledText {
                    text: item.markdown;
                    default-color: item.delivery == 2 ? Theme.danger : item.delivery == 1 || item.delivery == 3 ? Theme.muted : item.system ? Theme.muted : Theme.text;
                    default-font-family: Theme.font;
                    default-font-size: 15px;
                    link-color: #00a8fc;
                    accessible-role: text;
                    accessible-label: item.author + ": " + item.content;
                    link-clicked(link) => { root.open-link(link); }
                }
                if item.edited: Text {
                    text: "(edited)";
                    color: Theme.faint;
                    font-size: 11px;
                }
                if item.delivery == 2 || item.delivery == 3: Text {
                    text: item.delivery == 2 ? "Not sent" : "Delivery unknown. Check the conversation before sending it again.";
                    color: item.delivery == 2 ? Theme.danger : Theme.muted;
                    font-family: Theme.font;
                    font-size: 12px;
                }
            }
        }
    }
}

component SignInScreen inherits Rectangle {
    in property <string> status;
    in property <bool> busy;
    in property <bool> restoring;
    callback sign-in();
    background: Theme.dark ? #1e1f22 : #e3e5e8;
    Rectangle {
        width: min(480px, parent.width - 32px);
        height: card.preferred-height;
        border-radius: 8px;
        background: Theme.chat;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        card := VerticalLayout {
            padding: 32px;
            spacing: 16px;
            Image {
                source: @image-url("../../../assets/brand/serein-256.png");
                height: 72px;
                image-fit: contain;
            }
            Text {
                text: root.restoring ? "Welcome back" : "Sign in to Serein";
                color: Theme.strong;
                font-family: Theme.font;
                font-weight: 600;
                font-size: 24px;
                horizontal-alignment: center;
            }
            Text {
                text: "Serein uses Discord's own login page. Your password goes to Discord, never to Serein, and the session is kept in your system keychain.";
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 14px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            Button {
                text: root.busy ? "Waiting for Discord…" : "Log in with Discord";
                enabled: !root.busy;
                clicked => { root.sign-in(); }
            }
            if root.status != "": Text {
                text: root.status;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            Rectangle {
                border-radius: 4px;
                background: Theme.dark ? #3d3528 : #fdf5e1;
                warning := VerticalLayout {
                    padding: 12px;
                    Text {
                        text: "Serein is an unofficial client and is not endorsed by Discord. Signing in a normal account with an unofficial client may break Discord's Terms of Service and can lead to account enforcement.";
                        color: Theme.text;
                        font-family: Theme.font;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: root.window-title;
    min-width: 720px;
    min-height: 480px;
    preferred-width: 1240px;
    preferred-height: 800px;
    background: Theme.rail;
    default-font-family: Theme.font;

    // 0 sign-in, 1 connecting, 2 messaging
    in property <int> screen: 0;
    in property <string> window-title: "Serein";
    in property <string> sign-in-status;
    in property <bool> sign-in-busy;
    in property <bool> restoring;
    in property <string> connecting-status: "Connecting to Discord…";

    in property <[GuildItem]> guilds;
    in property <bool> home-selected;
    in property <bool> home-unread;
    in property <string> sidebar-title;
    in property <[ChannelItem]> channels;
    in property <string> conversation-title;
    in property <int> conversation-kind;
    in property <string> conversation-subtitle;
    in property <[MessageItem]> messages;
    in property <bool> has-conversation;
    in property <bool> can-send;
    in property <string> composer-placeholder;
    in property <string> typing-text;
    in property <string> banner;
    in property <bool> loading-older;
    in property <bool> history-start;
    in property <string> empty-title;
    in property <string> empty-detail;
    in property <string> user-name;
    in property <string> user-initials;
    in property <color> user-color: Theme.accent;
    in property <string> user-status;
    in property <bool> demo;
    // Bumped by Rust when a different conversation opens, so the timeline jumps to its end.
    in property <int> conversation-serial;

    callback sign-in();
    callback select-home();
    callback select-guild(string);
    callback select-channel(string);
    callback toggle-category(string);
    callback send-message(string) -> bool;
    callback typed(string);
    callback load-older();
    callback sign-out();
    callback toggle-theme();
    callback open-link(string);

    property <bool> stick-to-bottom: true;

    if root.screen == 0: SignInScreen {
        status: root.sign-in-status;
        busy: root.sign-in-busy;
        restoring: root.restoring;
        sign-in => { root.sign-in(); }
    }

    if root.screen == 1: Rectangle {
        background: Theme.rail;
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            Image {
                source: @image-url("../../../assets/brand/serein-256.png");
                height: 96px;
                image-fit: contain;
            }
            Text {
                text: root.connecting-status;
                color: Theme.muted;
                font-size: 15px;
                horizontal-alignment: center;
            }
        }
    }

    if root.screen == 2: HorizontalLayout {
        // Server rail
        Rectangle {
            width: 72px;
            background: Theme.rail;
            Flickable {
                content-height: rail.preferred-height;
                rail := VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 0px;
                    RailTile {
                        label: "Direct Messages";
                        icon: 31;
                        selected: root.home-selected;
                        unread: root.home-unread;
                        clicked => { root.select-home(); }
                    }
                    Rectangle {
                        height: 10px;
                        Rectangle {
                            width: 32px;
                            height: 2px;
                            border-radius: 1px;
                            background: Theme.selected;
                        }
                    }
                    for guild in root.guilds: RailTile {
                        label: guild.name;
                        initials: guild.initials;
                        fill: guild.color;
                        selected: guild.selected;
                        unread: guild.unread;
                        clicked => { root.select-guild(guild.id); }
                    }
                }
            }
        }

        // Channel sidebar
        Rectangle {
            width: 240px;
            background: Theme.sidebar;
            border-top-left-radius: 8px;
            VerticalLayout {
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        Text {
                            text: root.sidebar-title;
                            color: Theme.strong;
                            font-weight: 600;
                            font-size: 15px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
                ScrollView {
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        alignment: start;
                        for channel in root.channels: ChannelRow {
                            item: channel;
                            clicked => { root.select-channel(channel.id); }
                            toggled => { root.toggle-category(channel.id); }
                        }
                        if root.channels.length == 0: HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text {
                                text: root.home-selected ? "No direct messages yet." : "No channels you can open here.";
                                color: Theme.muted;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                // Account panel
                Rectangle {
                    height: 52px;
                    background: Theme.dark ? #232428 : #ebedef;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Avatar {
                            initials: root.user-initials;
                            fill: root.user-color;
                            size: 32px;
                            y: (parent.height - 32px) / 2;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.user-name;
                                color: Theme.strong;
                                font-weight: 600;
                                font-size: 14px;
                                overflow: elide;
                            }
                            Text {
                                text: root.user-status;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        IconButton {
                            icon: Theme.dark ? 82 : 82;
                            label: Theme.dark ? "Use light theme" : "Use dark theme";
                            y: (parent.height - 32px) / 2;
                            clicked => { root.toggle-theme(); }
                        }
                        IconButton {
                            icon: 75;
                            label: "Sign out";
                            y: (parent.height - 32px) / 2;
                            clicked => { root.sign-out(); }
                        }
                    }
                }
            }
        }

        // Conversation
        Rectangle {
            background: Theme.chat;
            VerticalLayout {
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        alignment: start;
                        if root.has-conversation: Icon {
                            index: root.conversation-kind == 1 ? 32 : root.conversation-kind == 3 ? 84 : root.conversation-kind == 4 ? 34 : root.conversation-kind == 5 || root.conversation-kind == 6 ? 31 : root.conversation-kind == 7 ? 93 : 33;
                            width: 22px;
                            height: 22px;
                            y: (parent.height - 22px) / 2;
                            tint: Theme.faint;
                        }
                        Text {
                            text: root.conversation-title;
                            color: Theme.strong;
                            font-weight: 600;
                            font-size: 16px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if root.conversation-subtitle != "": Rectangle {
                            width: 1px;
                            height: 24px;
                            y: (parent.height - 24px) / 2;
                            background: Theme.selected;
                        }
                        if root.conversation-subtitle != "": Text {
                            text: root.conversation-subtitle;
                            color: Theme.muted;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
                if root.banner != "": Rectangle {
                    height: 32px;
                    background: Theme.danger;
                    Text {
                        text: root.banner;
                        color: white;
                        font-weight: 500;
                        font-size: 13px;
                        overflow: elide;
                    }
                }
                if !root.has-conversation: Rectangle {
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Icon {
                            index: 31;
                            height: 64px;
                            tint: Theme.faint;
                        }
                        Text {
                            text: root.empty-title;
                            color: Theme.strong;
                            font-weight: 600;
                            font-size: 20px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.empty-detail;
                            color: Theme.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }
                    }
                }
                if root.has-conversation: timeline := ScrollView {
                    vertical-stretch: 1;
                    property <int> serial: root.conversation-serial;
                    changed serial => {
                        root.stick-to-bottom = true;
                        self.content-y = min(0px, self.visible-height - self.content-height);
                    }
                    changed content-height => {
                        if (root.stick-to-bottom) {
                            self.content-y = min(0px, self.visible-height - self.content-height);
                        }
                    }
                    changed visible-height => {
                        if (root.stick-to-bottom) {
                            self.content-y = min(0px, self.visible-height - self.content-height);
                        }
                    }
                    scrolled => {
                        root.stick-to-bottom = self.content-y <= self.visible-height - self.content-height + 8px;
                        if (self.content-y > -200px && !root.history-start && !root.loading-older) {
                            root.load-older();
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 16px;
                        if root.history-start: VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Rectangle {
                                width: 68px;
                                height: 68px;
                                border-radius: 34px;
                                background: Theme.raised;
                                Icon {
                                    index: root.conversation-kind == 5 || root.conversation-kind == 6 ? 31 : 33;
                                    width: 40px;
                                    height: 40px;
                                    tint: Theme.strong;
                                }
                            }
                            Text {
                                text: (root.conversation-kind == 5 || root.conversation-kind == 6 ? "" : "Welcome to #") + root.conversation-title;
                                color: Theme.strong;
                                font-weight: 600;
                                font-size: 28px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "This is the start of " + (root.conversation-kind == 5 || root.conversation-kind == 6 ? "your conversation with " + root.conversation-title : "the #" + root.conversation-title + " channel") + ".";
                                color: Theme.muted;
                                font-size: 15px;
                                wrap: word-wrap;
                            }
                        }
                        if root.loading-older: Text {
                            text: "Loading earlier messages…";
                            color: Theme.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            height: 32px;
                        }
                        for message in root.messages: MessageView {
                            item: message;
                            open-link(link) => { root.open-link(link); }
                        }
                    }
                }
                if root.has-conversation: VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 4px;
                    Rectangle {
                        min-height: 44px;
                        border-radius: 8px;
                        background: Theme.input;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 8px;
                            spacing: 8px;
                            composer := TextInput {
                                enabled: root.can-send;
                                single-line: false;
                                wrap: word-wrap;
                                color: Theme.text;
                                font-size: 15px;
                                vertical-alignment: center;
                                selection-background-color: Theme.accent.with-alpha(0.4);
                                accessible-label: root.composer-placeholder;
                                property <bool> empty: self.text == "";
                                edited => { root.typed(self.text); }
                                key-pressed(event) => {
                                    if (event.text == Key.Return && !event.modifiers.shift) {
                                        if (self.text != "" && root.send-message(self.text)) {
                                            self.text = "";
                                            root.typed("");
                                            root.stick-to-bottom = true;
                                        }
                                        return accept;
                                    }
                                    return reject;
                                }
                                Text {
                                    visible: composer.empty;
                                    text: root.composer-placeholder;
                                    color: Theme.faint;
                                    font-size: 15px;
                                    width: parent.width;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            IconButton {
                                icon: 35;
                                label: "Send message";
                                y: (parent.height - 32px) / 2;
                                active: !composer.empty;
                                clicked => {
                                    if (composer.text != "" && root.send-message(composer.text)) {
                                        composer.text = "";
                                        root.typed("");
                                        root.stick-to-bottom = true;
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        height: 20px;
                        text: root.typing-text;
                        color: Theme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

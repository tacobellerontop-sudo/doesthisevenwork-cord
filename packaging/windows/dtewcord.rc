			VALUE "OriginalFilename", "dtewcord.exe"
			VALUE "ProductName", "DTEW Cord"
			VALUE "ProductVersion", "0.1.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
